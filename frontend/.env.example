# The frontend needs no .env for the demo — `npm run dev` proxies /query and
# /health to http://127.0.0.1:8000 (see vite.config.js). Copy this file to
# .env only if your setup differs.

# Leave empty to use the Vite dev proxy (default).
# Set to e.g. http://127.0.0.1:8000 for a production build that calls the
# API directly instead of through the proxy.
VITE_API_BASE_URL=

# Only needed when the backend runs with DEMO_MODE=false and a BOT_API_KEY.
# Leave empty for the demo. Note that anything here ships in the client
# bundle, so never put a production secret in this file.
VITE_API_KEY=
