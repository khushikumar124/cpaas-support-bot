# ---------------------------------------------------------------------------
# The demo runs with NO .env file at all. Every value below has a working
# default. Copy this to .env only if you want to change something.
# ---------------------------------------------------------------------------

# Demo mode: /query needs no API key and localhost origins are allowed
# through CORS. Set to false for a real deployment (then BOT_API_KEY is
# required and the endpoint fails closed without it).
DEMO_MODE=true

# --- Data source ------------------------------------------------------------
# csv           → the bundled fictional data in data/ (default, no setup)
# google_sheets → a live Google Sheet; requires the two settings below
DATA_SOURCE=csv

GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=service-account.json
SHEETS_CACHE_TTL_SECONDS=60

# --- Parsing / answers ------------------------------------------------------
# auto   → OpenAI parser, automatic fallback to the offline rule parser
# rule   → offline rule parser only (no network, no key)
# openai → same as auto
PARSER_MODE=auto

# Leave OPENAI_API_KEY empty and everything still works: the rule-based
# parser handles the questions and the deterministic formatter writes the
# answers. Set a key to enable LLM parsing + natural-language answers.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Set to false to always use the deterministic formatter, even with a key set.
ANSWER_GENERATION=true

# --- API security (only used when DEMO_MODE=false) --------------------------
# Shared secret clients must send as the X-API-Key header on every /query.
BOT_API_KEY=

# Comma-separated browser origins allowed via CORS.
# Empty + DEMO_MODE=true means localhost:5173/4173 are allowed automatically.
CORS_ALLOWED_ORIGINS=

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
